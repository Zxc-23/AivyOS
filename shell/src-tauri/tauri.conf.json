{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AivyOS",
  "version": "0.1.2",
  "identifier": "com.aivyos.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AivyOS",
        "width": 960,
        "height": 680,
        "minWidth": 480,
        "minHeight": 380,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Zxc-23/AivyOS/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU4MTVEQjcxMjg5QUU3RDUKUldUVjU1b29jZHNWNkFyK2ZSMkwvN0U5RlRhT2NoWkMxcTZXZjQ1MWhGWHFxTFNTN1djRHFkdXgK"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "createUpdaterArtifacts": true
  }
}
