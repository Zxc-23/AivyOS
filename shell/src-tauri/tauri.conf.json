{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AivyOS",
  "version": "0.1.0",
  "identifier": "com.aivyos.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AivyOS",
        "width": 960,
        "height": 680,
        "minWidth": 480,
        "minHeight": 380,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://api.aivyos.local/update/{{target}}/{{arch}}/{{current_version}}"
      ],
      "pubkey": ""
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": []
  }
}
